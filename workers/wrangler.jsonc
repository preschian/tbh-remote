{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tbh-remote",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_ROOM",
				"class_name": "DeviceRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DeviceRoom"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tbh-remote",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PAIRING",
			"id": "00000000-0000-0000-0000-000000000000"
		}
	]
}
